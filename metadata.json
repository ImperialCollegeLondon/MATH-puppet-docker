{
  "name": "imperialcollegelondon-docker_maths",
  "version": "1.0.0",
  "author": "Tim Greaves",
  "summary": "Docker installation for Imperial Maths department servers, with configurable docker-group membership",
  "license": "Apache-2.0",
  "source": "https://github.com/ImperialCollegeLondon/MATH-puppet-docker.git",
  "dependencies": [
    {
      "name": "puppetlabs/docker",
      "version_requirement": ">= 10.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "24.04",
        "26.04"
      ]
    }
  ]
}
